
# ─────────────────────────────────────────────
# Django
# ─────────────────────────────────────────────

# Generate a strong secret key for production.
# Never commit the real SECRET_KEY.
SECRET_KEY=

# Local development: True
# Render production: False
DEBUG=True


# ─────────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────────

DB_NAME=ecommarce_db
DB_USER=
DB_PASSWORD=

# Local machine:
# DB_HOST=localhost
#
# Docker Compose:
# DB_HOST=db
#
# Render:
# Use the Render PostgreSQL internal hostname.
DB_HOST=localhost

DB_PORT=5432


# ─────────────────────────────────────────────
# Email / Gmail SMTP
# ─────────────────────────────────────────────

# Use a Gmail App Password, NOT your normal Gmail password.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=


# ─────────────────────────────────────────────
# Demo mode
# ─────────────────────────────────────────────

# False (default): full flow, email verification + order emails via Celery.
# True: for free hosting without a Celery worker / SMTP (e.g. Render free).
#       New users are auto-verified and no emails are sent.
DEMO_MODE=False


# ─────────────────────────────────────────────
# Celery / Redis
# ─────────────────────────────────────────────

# Local machine:
# redis://localhost:6379/0
#
# Docker Compose:
# redis://redis:6379/0
#
# Render:
# Use the Redis connection URL provided by your Redis service.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0


# ─────────────────────────────────────────────
# Site
# ─────────────────────────────────────────────

SITE_NAME=ShopKart
DELIVERY_DAYS=3

# ─────────────────────────────────────────────
# Cloudinary (product image storage)
# ─────────────────────────────────────────────

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Local:
SITE_DOMAIN=http://127.0.0.1:8000

# Render:
# SITE_DOMAIN=https://your-app-name.onrender.com


# ─────────────────────────────────────────────
# Hosts
# ─────────────────────────────────────────────

# Local:
ALLOWED_HOSTS=127.0.0.1,localhost

# Render:
# ALLOWED_HOSTS=your-app-name.onrender.com
